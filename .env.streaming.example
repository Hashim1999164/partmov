# Streaming V2 local / VPS env (never commit production secrets)

NODE_ENV=development
DATABASE_URL=postgres://partmov:partmov@127.0.0.1:5432/partmov
REDIS_URL=redis://127.0.0.1:6379
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=partmov
MINIO_SECRET_KEY=partmovsecret
MEDIA_HMAC_SECRET=dev-media-hmac-change-me
SESSION_HMAC_SECRET=dev-session-hmac-change-me
MEDIA_PUBLIC_BASE=http://127.0.0.1:8088/hls
PUBLIC_APP_URL=http://127.0.0.1:3000

NEXT_PUBLIC_STREAMING_V2=false
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080
NEXT_PUBLIC_SYNC_WS=ws://127.0.0.1:8090/ws

WORKER_CONCURRENCY=1
ENCODER_VERSION=partmov-ffmpeg-v1

# R2 free-tier guard (10 GiB). New rooms/uploads/playback sessions blocked near the cap.
STORAGE_LIMIT_BYTES=10737418240
STORAGE_GUARD_BYTES=268435456
